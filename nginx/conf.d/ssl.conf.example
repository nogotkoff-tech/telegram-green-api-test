# Example HTTPS / SSL configuration for VPS deployment with Let's Encrypt / Certbot
# To use:
# 1. Obtain certificates using certbot:
#    docker compose run --rm certbot certonly --webroot -w /var/www/certbot -d yourdomain.com
# 2. Rename this file to ssl.conf (or copy its contents into default.conf)
# 3. Replace 'yourdomain.com' with your actual domain
# 4. Restart nginx: docker compose restart nginx

# Redirect HTTP to HTTPS
# server {
#     listen 80;
#     listen [::]:80;
#     server_name yourdomain.com;
# 
#     location /.well-known/acme-challenge/ {
#         root /var/www/certbot;
#     }
# 
#     location / {
#         return 301 https://$host$request_uri;
#     }
# }

